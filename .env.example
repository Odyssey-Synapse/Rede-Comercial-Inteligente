# Origin privado protegido pelo Cloudflare Access. Server-side only.
MCIR_PUBLIC_ASSISTANT_ORIGIN=

# Service Token do Cloudflare Access. Server-side only.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Segredo do gateway MCIR. Server-side only.
MCIR_ASSISTANT_GATEWAY_SECRET=

# Opcional: entre 3000 e 25000 milissegundos.
MCIR_REQUEST_TIMEOUT_MS=18000
