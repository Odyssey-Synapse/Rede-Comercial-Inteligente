# Receita / SERPRO
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_CNPJ_ENDPOINT_TEMPLATE=

# Assinaturas e propostas
COMPANY_LOOKUP_SIGNING_SECRET=
QUOTE_SIGNING_SECRET=
DATABASE_URL=

# Antiabuso
TURNSTILE_REQUIRED=true
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contato via Resend
RESEND_API_KEY=
# Exemplo somente após verificar um domínio próprio no Resend:
RESEND_FROM_EMAIL=Achei Aqui <contato@seudominio.com.br>
# Seu e-mail pessoal pode ficar aqui; ele não é exposto ao navegador:
CONTACT_DESTINATION_EMAIL=
# Opcional: endereço público, se quiser exibi-lo no site.
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTACT_WHATSAPP=

# Privacidade / controlador
PUBLIC_PRIVACY_EMAIL=
CONTROLLER_LEGAL_NAME=
CONTROLLER_DOCUMENT=
PRIVACY_POLICY_STATUS=PENDING

# PostgreSQL / propostas
POSTGRES_URL=

# SERPRO Consulta CNPJ
SERPRO_MODE=production
SERPRO_CONSUMER_KEY=
SERPRO_CONSUMER_SECRET=
SERPRO_TOKEN_URL=https://gateway.apiserpro.serpro.gov.br/token
# Preencha com o endpoint EXATO disponibilizado no contrato/swagger do SERPRO.
# Deve conter {cnpj}. Não altere maiúsculas/minúsculas do endpoint contratado.
SERPRO_CNPJ_ENDPOINT_TEMPLATE=
SERPRO_TIMEOUT_MS=8000
SERPRO_REQUEST_TAG_PREFIX=ACHEIAQUI
COMPANY_LOOKUP_TTL_MINUTES=15

# Para testes do ambiente Trial, use SERPRO_MODE=trial e:
SERPRO_TRIAL_BEARER_TOKEN=

# Founder — somente server-side. Até 25 CNPJs separados por vírgula.
FOUNDER_CNPJ_REGISTRY=
FOUNDER_REGISTRY_VERSION=FOUNDER-001
